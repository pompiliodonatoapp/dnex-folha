{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dnex.local/contracts/folha.portal-documento-publicado.v1.schema.json",
  "title": "Documento Publicado v1",
  "description": "Item retornado pela função listar_meus_documentos do DNEX Folha.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "employer_id",
    "employer_nome",
    "establishment_inscricao",
    "tipo",
    "competencia",
    "titulo",
    "published_at",
    "tamanho_bytes",
    "visto_em"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "employer_id": {
      "type": "string",
      "format": "uuid"
    },
    "employer_nome": {
      "type": "string",
      "minLength": 1
    },
    "establishment_inscricao": {
      "type": ["string", "null"]
    },
    "tipo": {
      "type": "string",
      "enum": [
        "holerite",
        "ferias_recibo",
        "ferias_aviso",
        "decimo_terceiro",
        "informe_rendimentos",
        "espelho_ponto",
        "rescisao"
      ]
    },
    "competencia": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-01$"
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "tamanho_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "visto_em": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}